{
    "compilerOptions": {
        "baseUrl": ".",
        "paths": {
            "@/*": ["resources/js/*"]
        },
        "target": "esnext",
        "module": "esnext",
        "moduleResolution": "node",
        "jsx": "preserve"
    },
    "include": ["resources/js/**/*", "resources/js/**/*.vue"],
    "exclude": ["node_modules"]
}
